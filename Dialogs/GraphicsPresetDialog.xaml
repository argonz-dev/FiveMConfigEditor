<Window x:Class="FiveMConfigEditorWPF.Dialogs.GraphicsPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Graphics Presets"
        Width="600" Height="450"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="12" Background="#FF1A0F0A"
          BorderBrush="#FF4A3020" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#FF8C00" BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
    </Border.Effect>

    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock Text="Graphics Presets" Foreground="White"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="Simpan dan muat preset graphics settings"
                   Foreground="#FFAA8866" FontSize="11"/>
      </StackPanel>

      <!-- Preset List -->
      <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Preset Name:" Foreground="#FFAA8866" FontSize="11" 
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtPresetName" Width="200" 
                     Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0"/>
            <Button Content="Save Current" Style="{StaticResource NeonButtonSmallStyle}"
                    Click="BtnSavePreset_Click"/>
          </StackPanel>

          <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                        VerticalScrollBarVisibility="Auto">
            <ListBox x:Name="LstPresets" Background="Transparent" BorderThickness="0"
                     SelectionChanged="LstPresets_SelectionChanged">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FF2A1810" BorderBrush="#FF4A3020" BorderThickness="1"
                          CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" Foreground="White" 
                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding Description}" Foreground="#FFAA8866" 
                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Foreground="#FF888888" FontSize="9">
                          <Run Text="Created: "/>
                          <Run Text="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}"/>
                        </TextBlock>
                      </StackPanel>

                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Load" Width="60" Margin="0,0,4,0"
                                Style="{StaticResource GreenButtonSmallStyle}"
                                Tag="{Binding}" Click="BtnLoadPreset_Click"/>
                        <Button Content="Delete" Width="60"
                                Style="{StaticResource RedButtonSmallStyle}"
                                Tag="{Binding}" Click="BtnDeletePreset_Click"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Footer Buttons -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
        <Button Content="Close" Width="100" Style="{StaticResource NeonButtonStyle}"
                Click="BtnClose_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

<Window x:Class="FiveMConfigEditorWPF.Dialogs.PresetConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="580"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Border Background="#FF1A0F0A" CornerRadius="12"
          BorderBrush="#FF4A3020" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#FF8C00" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border Grid.Row="0" Background="#FF2A1810" CornerRadius="12,12,0,0"
              MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid Margin="16,0">
          <TextBlock x:Name="TxtTitle" Text="Config Preset"
                     Foreground="White" FontSize="13" FontWeight="Bold"
                     VerticalAlignment="Center"/>
          <Button Content="✕" HorizontalAlignment="Right"
                  Style="{StaticResource CloseButtonStyle}"
                  Click="BtnClose_Click"/>
        </Grid>
      </Border>

      <!-- Custom Tab Bar -->
      <Border Grid.Row="1" Background="#FF1F1410" Padding="12,8,12,0">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnTabForm" Content="⚙  Form"
                  Click="BtnTabForm_Click" Tag="Form"
                  Width="110" Height="32" Cursor="Hand">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="#FFFF8C00"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}"
                              CornerRadius="6,6,0,0" Padding="10,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
          </Button>
          <Button x:Name="BtnTabManual" Content="📝  Manual"
                  Click="BtnTabManual_Click" Tag="Manual"
                  Width="110" Height="32" Cursor="Hand" Margin="4,0,0,0">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="#FF1E1E32"/>
                <Setter Property="Foreground" Value="#FFAA8866"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}"
                              CornerRadius="6,6,0,0" Padding="10,6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#FF2A2A44"/>
                          <Setter Property="Foreground" Value="#FFBBBBCC"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
          </Button>
        </StackPanel>
      </Border>

      <!-- Tab Content -->
      <Border Grid.Row="2" Background="#FF1F1410">
        <Grid>
          <!-- FORM panel -->
          <ScrollViewer x:Name="PanelForm"
                      VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource DarkScrollViewerStyle}">
          <StackPanel Margin="20,14,20,14">

            <TextBlock Text="Game" Foreground="#FFFF8C00" FontSize="12"
                       FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="GTA V Path" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtIVPath" Grid.Column="0"
                       Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0"/>
              <Button Grid.Column="1" Content="..." Width="38"
                      Style="{StaticResource NeonButtonSmallStyle}"
                      Click="BtnBrowseGTA_Click"/>
            </Grid>

            <TextBlock Text="Build Number" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtBuildNumber" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

            <CheckBox x:Name="ChkReplaceExe" Content="Replace Executable"
                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,16"/>

            <TextBlock Text="Addons" Foreground="#FFFF8C00" FontSize="12"
                       FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="ReShade5" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtReShade5" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,16"/>

            <TextBlock Text="Pool Sizes" Foreground="#FFFF8C00" FontSize="12"
                       FontWeight="Bold" Margin="0,0,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <DataGrid x:Name="GridPools" Grid.Column="0"
                        AutoGenerateColumns="False" CanUserAddRows="False"
                        Background="#FF1F1410" Foreground="#FFE0E0E0"
                        BorderBrush="#FF4A3020" BorderThickness="1"
                        RowBackground="#FF2A1810" AlternatingRowBackground="#FF1F1410"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#FF4A3020"
                        HeadersVisibility="Column" SelectionMode="Single" MaxHeight="160">
                <DataGrid.ColumnHeaderStyle>
                  <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#FF0F0A08"/>
                    <Setter Property="Foreground" Value="#FFAA8866"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontSize" Value="11"/>
                  </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                  <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="#FFE0E0E0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,3"/>
                    <Style.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#1AFF8C00"/>
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Pool Key" Binding="{Binding Key}" Width="*" IsReadOnly="True"/>
                  <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="90"/>
                </DataGrid.Columns>
              </DataGrid>
              <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                <Button Content="+ Tambah" Style="{StaticResource GreenButtonSmallStyle}"
                        Margin="0,0,0,5" Click="BtnAddPool_Click"/>
                <Button Content="✕ Hapus" Style="{StaticResource RedButtonSmallStyle}"
                        Margin="0,0,0,5" Click="BtnRemovePool_Click"/>
                <Button Content="🗑 Clear" Style="{StaticResource NeonButtonSmallStyle}"
                        Click="BtnClearPools_Click"/>
              </StackPanel>
            </Grid>

          </StackPanel>
        </ScrollViewer>

        <!-- MANUAL panel -->
        <Grid x:Name="PanelManual" Visibility="Collapsed" Margin="20,14,20,14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0"
                     Text="Edit langsung seperti file .ini — copy paste dari file asli juga bisa."
                     Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,8"/>
          <TextBox Grid.Row="1" x:Name="TxtRawIni"
                   Background="#FF0A0A18" Foreground="#FFE0E0E0"
                   BorderBrush="#FF4A3020" BorderThickness="1"
                   FontFamily="Consolas" FontSize="12"
                   AcceptsReturn="True" AcceptsTab="True"
                   VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   TextWrapping="NoWrap" Padding="10"
                   CaretBrush="#FFFF8C00"/>
          <Button Grid.Row="2" Content="↻  Parse ke Form"
                  Style="{StaticResource NeonButtonSmallStyle}"
                  HorizontalAlignment="Right" Margin="0,8,0,0"
                  Click="BtnParseRaw_Click"/>
        </Grid>

        </Grid>
      </Border>

      <!-- Bottom buttons -->
      <StackPanel Grid.Row="3" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="20,10,20,14">
        <Button Content="Batal" Style="{StaticResource RedButtonSmallStyle}"
                Width="80" Margin="0,0,8,0" Click="BtnCancel_Click"/>
        <Button Content="💾  Simpan" Style="{StaticResource NeonButtonStyle}"
                Width="110" Click="BtnSave_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

<Window x:Class="FiveMConfigEditorWPF.Dialogs.ImportPackConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konfirmasi Import Mod Pack"
        Width="520" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="12" Background="#FF1A0F0A"
          BorderBrush="#FF4A3020" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#FF8C00" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Border Grid.Row="0" Background="#FF2A1810" CornerRadius="12,12,0,0"
              Padding="20,16">
        <StackPanel>
          <TextBlock Text="📦 Import Mod Pack" Foreground="#FFFF8C00"
                     FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
          <TextBlock Text="Konfirmasi dan Backup" Foreground="#FFAA8866"
                     FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <!-- Content -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Style="{StaticResource DarkScrollViewerStyle}">
        <StackPanel Margin="20,16,20,10">

          <!-- Pack Info -->
          <Border Background="#FF2A1810" BorderBrush="#FF4A3020" BorderThickness="1"
                  CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="Informasi Mod Pack" Foreground="#FFFF8C00"
                         FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
              
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="100"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nama:" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtPackName" Text="-" Foreground="#FFE0E0E0" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPackAuthor" Text="-" Foreground="#FFE0E0E0" FontSize="11" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Dibuat:" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtPackDate" Text="-" Foreground="#FFE0E0E0" FontSize="11" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Ukuran:" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtPackSize" Text="-" Foreground="#FFE0E0E0" FontSize="11" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Mods:" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,6"/>
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtPackMods" Text="-" Foreground="#FFE0E0E0" FontSize="11" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Plugins:" Foreground="#FFAA8866" FontSize="11"/>
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtPackPlugins" Text="-" Foreground="#FFE0E0E0" FontSize="11"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- Current State -->
          <Border Background="#0FFF8C00" BorderBrush="#33FF8C00" BorderThickness="1"
                  CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="⚠" Foreground="#FFFF8C00" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Kondisi Saat Ini" Foreground="#FFFF8C00"
                           FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="📦 Mods aktif: " Foreground="#FFAA8866" FontSize="11" Width="100"/>
                <TextBlock x:Name="TxtCurrentMods" Text="0 item" Foreground="#FFE0E0E0" FontSize="11"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔌 Plugins aktif: " Foreground="#FFAA8866" FontSize="11" Width="100"/>
                <TextBlock x:Name="TxtCurrentPlugins" Text="0 item" Foreground="#FFE0E0E0" FontSize="11"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Backup Options -->
          <Border Background="#FF2A1810" BorderBrush="#FF4A3020" BorderThickness="1"
                  CornerRadius="8" Padding="14,12">
            <StackPanel>
              <TextBlock Text="Opsi Backup" Foreground="#FFFF8C00"
                         FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>

              <CheckBox x:Name="ChkCreateBackup" Content="Buat backup preset sebelum import"
                        Style="{StaticResource DarkCheckBoxStyle}"
                        IsChecked="True" Margin="0,0,0,8"/>

              <StackPanel x:Name="PanelBackupName" Margin="20,0,0,0">
                <TextBlock Text="Nama Backup Preset:" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtBackupName" Style="{StaticResource DarkTextBoxStyle}"
                         Text="Backup sebelum import"/>
              </StackPanel>

              <Border Background="#0F2ECC71" BorderBrush="#332ECC71" BorderThickness="1"
                      CornerRadius="6" Padding="10,8" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="💡" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Foreground="#FFAA8866" FontSize="10" TextWrapping="Wrap">
                    <Run Text="Backup akan menyimpan kondisi mods dan plugins saat ini sebagai Graphics Preset."/>
                    <LineBreak/>
                    <Run Text="Anda dapat mengembalikannya kapan saja dari menu Mod Manager."/>
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

      <!-- Footer -->
      <Border Grid.Row="2" Background="#FF0F0A08" CornerRadius="0,0,12,12"
              Padding="20,12,20,16">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="❌ Batal" Style="{StaticResource RedButtonStyle}"
                  Width="100" Margin="0,0,8,0" Click="BtnCancel_Click"/>
          <Button Content="📦 Import" Style="{StaticResource GreenButtonStyle}"
                  Width="120" Click="BtnImport_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>

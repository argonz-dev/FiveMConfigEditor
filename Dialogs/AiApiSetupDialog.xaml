<Window x:Class="FiveMConfigEditorWPF.Dialogs.AiApiSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="AI Provider Configuration"
        Width="520" Height="490"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="8" Background="{StaticResource BgCardBrush}"
          BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="46"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Border Grid.Row="0" Background="{StaticResource BgDeepBrush}" CornerRadius="8,8,0,0"
              BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="16,0">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <fa:IconBlock Icon="Server" FontSize="13" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Konfigurasi AI Provider &amp; Model" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>

          <Button x:Name="BtnClose" Width="28" Height="26"
                  HorizontalAlignment="Right"
                  Foreground="{StaticResource TextSubBrush}" Background="Transparent" BorderThickness="0"
                  FontSize="12" Cursor="Hand" Click="BtnClose_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#22DA3633"/>
                          <Setter Property="Foreground" Value="#FFF85149"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <fa:IconBlock Icon="Xmark" FontSize="12"/>
          </Button>
        </Grid>
      </Border>

      <!-- Content -->
      <StackPanel Grid.Row="1" Margin="20,16">
        <!-- Quick Preset Selection -->
        <TextBlock Text="Pilihan Preset Provider:" Foreground="{StaticResource TextSubBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <WrapPanel Margin="0,0,0,14">
          <Button x:Name="BtnPresetVpsIp" Content="VPS 103 (103.103.22.86)"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Margin="0,0,6,6" Padding="8,4" FontSize="11" Click="BtnPresetVpsIp_Click"/>
          <Button x:Name="BtnPresetVpsDomain" Content="VPS 103 (Domain)"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Margin="0,0,6,6" Padding="8,4" FontSize="11" Click="BtnPresetVpsDomain_Click"/>
          <Button x:Name="BtnPresetLocalhost" Content="Local (9router)"
                  Style="{StaticResource SecondaryButtonStyle}"
                  Margin="0,0,6,6" Padding="8,4" FontSize="11" Click="BtnPresetLocalhost_Click"/>
        </WrapPanel>

        <!-- Base URL -->
        <TextBlock Text="API Base URL (OpenAI-compatible):" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtBaseUrl" Style="{StaticResource DarkTextBoxStyle}" Height="36" Margin="0,0,0,12"/>

        <!-- API Key -->
        <TextBlock Text="API Key:" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <TextBox x:Name="TxtApiKey" Style="{StaticResource DarkTextBoxStyle}" Height="36" Margin="0,0,0,12"/>

        <!-- Model Selection -->
        <TextBlock Text="Model ID:" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TxtModel" Style="{StaticResource DarkTextBoxStyle}" Height="36" Grid.Column="0"/>
          <ComboBox x:Name="CboModelPresets" Grid.Column="1" Width="140" Height="36" Margin="6,0,0,0"
                    Style="{StaticResource DarkComboBoxStyle}"
                    SelectionChanged="CboModelPresets_SelectionChanged">
            <ComboBoxItem Content="-- Preset Model --" IsSelected="True"/>
            <ComboBoxItem Content="gemini-3.8-flash-high"/>
            <ComboBoxItem Content="claude-sonnet-4-6"/>
            <ComboBoxItem Content="claude-opus-4-6-thinking"/>
            <ComboBoxItem Content="gemini-3-flash"/>
            <ComboBoxItem Content="gemini-2.5-pro"/>
            <ComboBoxItem Content="gpt-oss-120b-medium"/>
            <ComboBoxItem Content="argzgemini"/>
          </ComboBox>
        </Grid>

        <!-- Test Connection Result -->
        <Border Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,4">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnTest" Content="Test Koneksi" Grid.Column="0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,4" FontSize="11" Click="BtnTest_Click"/>
            <TextBlock x:Name="TxtTestStatus" Text="Status: Belum diuji"
                       Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{StaticResource TextSubBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Bottom Buttons -->
      <Border Grid.Row="2" Background="{StaticResource BgDeepBrush}" CornerRadius="0,0,8,8"
              BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,1,0,0" Padding="16,12">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Batal" Width="90" Height="32" Margin="0,0,8,0"
                  Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancel_Click"/>
          <Button Content="Simpan" Width="90" Height="32"
                  Style="{StaticResource NeonButtonStyle}" Click="BtnSave_Click"/>
        </StackPanel>
      </Border>

    </Grid>
  </Border>
</Window>
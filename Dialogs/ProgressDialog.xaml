<Window x:Class="FiveMConfigEditorWPF.Dialogs.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing"
        Width="400" Height="180"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Border CornerRadius="10" Background="#FF2A1810"
          BorderBrush="#FF4A3020" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#FF8C00" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
    </Border.Effect>
    <Grid Margin="30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Icon + Title -->
      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
        <TextBlock x:Name="TxtIcon" Text="⏳" FontSize="24" Margin="0,0,10,0"/>
        <TextBlock x:Name="TxtTitle" Text="Processing..." Foreground="White"
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Progress Bar -->
      <ProgressBar Grid.Row="1" Height="8" IsIndeterminate="True"
                   Foreground="#FFFF8C00" Background="#FF4A3020"
                   BorderThickness="0" Margin="0,0,0,12"/>

      <!-- Status Text -->
      <TextBlock Grid.Row="2" x:Name="TxtStatus" Text="Mohon tunggu..."
                 Foreground="#FFAA8866" FontSize="12"
                 HorizontalAlignment="Center" VerticalAlignment="Top"
                 TextWrapping="Wrap" TextAlignment="Center"/>
    </Grid>
  </Border>
</Window>

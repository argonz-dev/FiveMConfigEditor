<Window x:Class="FiveMConfigEditorWPF.Dialogs.SaveGraphicsPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simpan Graphics Preset"
        Width="400" Height="280"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <Border CornerRadius="10" Background="#FF2A1810"
          BorderBrush="#FF4A3020" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#FF8C00" BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
    </Border.Effect>
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="💾 Simpan Graphics Preset"
                 Foreground="#FFFF8C00" FontSize="14" FontWeight="Bold" Margin="0,0,0,16"/>

      <TextBlock Grid.Row="1" Text="Nama Preset" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
      <TextBox x:Name="TxtName" Grid.Row="2"
               Style="{StaticResource DarkTextBoxStyle}"
               Margin="0,0,0,10" Height="38"/>

      <TextBlock Grid.Row="3" Text="Deskripsi (opsional)" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
      <TextBox x:Name="TxtDesc" Grid.Row="4"
               Style="{StaticResource DarkTextBoxStyle}"
               Height="38" VerticalAlignment="Top"/>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Batal" Click="BtnCancel_Click" Width="80" Height="30"
                Background="#FF4A3020" Foreground="#FFE0E0E0" BorderThickness="0"
                Cursor="Hand" Margin="0,0,8,0">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Button.Style>
        </Button>
        <Button Content="💾 Simpan" Click="BtnSave_Click" Width="90" Height="30"
                Background="#FFFF8C00" Foreground="White" BorderThickness="0" Cursor="Hand">
          <Button.Style>
            <Style TargetType="Button">
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Button.Style>
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>

<Window x:Class="FiveMConfigEditorWPF.Dialogs.PresetEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Preset"
        Width="420" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="12" Background="#FF2A1810"
          BorderBrush="#FF4A3020" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#FF8C00" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Border Grid.Row="0" Background="#FF0F0A08" CornerRadius="12,12,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="✎ Edit Preset" Foreground="#FFFF8C00"
                   FontSize="13" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="16,0"/>
      </Border>

      <!-- Form -->
      <StackPanel Grid.Row="1" Margin="20,16,20,8">
        <TextBlock Text="Nama Preset" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

        <TextBlock Text="Deskripsi" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtDesc" Style="{StaticResource DarkTextBoxStyle}"
                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

        <TextBlock Text="Gambar (opsional)" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="TxtImagePath" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0"/>
          <Button Grid.Column="1" Content="📁" Style="{StaticResource NeonButtonSmallStyle}"
                  Width="36" Click="BtnBrowseImage_Click"/>
        </Grid>

        <!-- Image Preview -->
        <Border Background="#FF1A0F0A" CornerRadius="6" Height="60"
                BorderBrush="#FF4A3020" BorderThickness="1">
          <Image x:Name="ImgPreview" Stretch="Uniform" Margin="4"/>
        </Border>
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="20,0,20,16">
        <Button Content="Batal" Style="{StaticResource RedButtonStyle}"
                Margin="0,0,8,0" Click="BtnCancel_Click"/>
        <Button Content="✓ Simpan" Style="{StaticResource GreenButtonStyle}"
                Click="BtnOk_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

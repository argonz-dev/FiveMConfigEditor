<Window x:Class="FiveMConfigEditorWPF.Dialogs.PresetEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Preset"
        Width="440" Height="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="8" Background="#FF0D1117"
          BorderBrush="#FF21262D" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Border Grid.Row="0" Background="#FF0F0A08" CornerRadius="12,12,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="✎ Edit Preset" Foreground="#FFFF8C00"
                   FontSize="13" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="16,0"/>
      </Border>

      <!-- Form -->
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource DarkScrollViewerStyle}">
        <StackPanel Margin="20,16,20,8">
          <TextBlock Text="Nama Preset" Foreground="#FF8B949E" FontSize="11" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtName" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

          <TextBlock Text="Deskripsi" Foreground="#FF8B949E" FontSize="11" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtDesc" Style="{StaticResource DarkTextBoxStyle}"
                   Height="54" TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

          <TextBlock Text="Server Connect / Host (opsional, untuk tombol Play)" Foreground="#FF8B949E" FontSize="11" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtServerUrl" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}"
                     ToolTip="Contoh: main.imeroleplay.com atau cfx.re/join/xxxxx (kosongkan untuk buka menu FiveM)"
                     Margin="0,0,8,0"/>
            <Button x:Name="BtnFetchServerAssets" Grid.Column="1" Content="🌐 Ambil Logo &amp; Banner"
                    Style="{StaticResource NeonButtonSmallStyle}" Padding="10,6"
                    Click="BtnFetchServerAssets_Click"
                    ToolTip="Ambil icon/logo dan banner langsung dari server FiveM"/>
          </Grid>

          <TextBlock Text="Nickname Preset (cl_nickname — opsional, otomatis diset saat Play)" Foreground="#FF8B949E" FontSize="11" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtKeptNickname" Style="{StaticResource DarkTextBoxStyle}"
                   ToolTip="Opsional: otomatis menulis cl_nickname ke fivem.cfg saat Play"
                   Margin="0,0,0,12"/>

          <TextBlock Text="Gambar / Logo (opsional)" Foreground="#FF8B949E" FontSize="11" Margin="0,0,0,4"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtImagePath" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0"/>
            <Button Grid.Column="1" Content="📁" Style="{StaticResource NeonButtonSmallStyle}"
                    Width="36" Click="BtnBrowseImage_Click"/>
          </Grid>

          <TextBlock Text="Banner Server (opsional)" Foreground="#FF8B949E" FontSize="11" Margin="0,0,0,4"/>
          <TextBox x:Name="TxtBannerPath" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

          <!-- Image & Banner Preview -->
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="72"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FF0D1117" CornerRadius="6" Height="60"
                    BorderBrush="#FF21262D" BorderThickness="1">
              <Image x:Name="ImgPreview" Stretch="Uniform" Margin="4"/>
            </Border>
            <Border Grid.Column="2" Background="#FF0D1117" CornerRadius="6" Height="60"
                    BorderBrush="#FF21262D" BorderThickness="1" ClipToBounds="True">
              <Image x:Name="ImgBannerPreview" Stretch="UniformToFill"/>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- Buttons -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="20,0,20,16">
        <Button Content="Batal" Style="{StaticResource RedButtonStyle}"
                Margin="0,0,8,0" Click="BtnCancel_Click"/>
        <Button Content="✓ Simpan" Style="{StaticResource GreenButtonStyle}"
                Click="BtnOk_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

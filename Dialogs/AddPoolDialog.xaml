<Window x:Class="FiveMConfigEditorWPF.Dialogs.AddPoolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Pool Size"
        Width="360" Height="240"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

  <Border CornerRadius="12" Background="#FF2A1810"
          BorderBrush="#FF4A3020" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#FF8C00" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Border Grid.Row="0" Background="#FF0F0A08" CornerRadius="12,12,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <TextBlock Text="+ Tambah Pool Size" Foreground="#FFFF8C00"
                   FontSize="13" FontWeight="Bold"
                   VerticalAlignment="Center" Margin="16,0"/>
      </Border>

      <!-- Form -->
      <StackPanel Grid.Row="1" Margin="20,16,20,8">
        <TextBlock Text="Pool Key" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
        <ComboBox x:Name="CmbPoolKey" Style="{StaticResource DarkComboBoxStyle}"
                  IsEditable="True" Margin="0,0,0,12"/>

        <TextBlock Text="Value" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtValue" Style="{StaticResource DarkTextBoxStyle}"
                 Text="1000" PreviewTextInput="TxtValue_PreviewTextInput"/>
      </StackPanel>

      <!-- Buttons -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                  Margin="20,0,20,16">
        <Button Content="Batal" Style="{StaticResource RedButtonStyle}"
                Margin="0,0,8,0" Click="BtnCancel_Click"/>
        <Button Content="✓ Tambah" Style="{StaticResource NeonButtonStyle}"
                Click="BtnOk_Click"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>

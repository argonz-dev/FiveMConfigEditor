<Window x:Class="FiveMConfigEditorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="FiveM Config Editor"
        Width="880" Height="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

  <Border CornerRadius="8" Background="{StaticResource BgDeepBrush}"
          BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.45"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Minimalist Title Bar -->
      <Border Grid.Row="0" Background="{StaticResource BgSidebarBrush}" CornerRadius="8,8,0,0"
              BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Logo + Title + Version Badge -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
            <Image Source="logo.png" Width="22" Height="22" Margin="0,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="FiveM Config Editor" Foreground="{StaticResource TextPrimaryBrush}"
                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Background="#15FFFFFF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="v2.0.0" Foreground="{StaticResource AccentOrangeBrush}" FontSize="10" FontWeight="Bold"/>
            </Border>
          </StackPanel>

          <!-- Window Controls -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Button x:Name="BtnCheckUpdate" Width="32" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="BtnCheckUpdate_Click"
                    ToolTip="Check for Updates">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
              <fa:IconBlock x:Name="IconCheckUpdate" Icon="Rotate" FontSize="12" Foreground="{StaticResource TextSubBrush}"/>
            </Button>

            <Button x:Name="BtnMinimize" Width="32" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="BtnMinimize_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
              <fa:IconBlock Icon="WindowMinimize" FontSize="10" Margin="0,-4,0,0" Foreground="{StaticResource TextSubBrush}"/>
            </Button>

            <Button x:Name="BtnClose" Width="32" Height="28"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Click="BtnClose_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentRedBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
              <fa:IconBlock Icon="Xmark" FontSize="13" Foreground="{StaticResource TextSubBrush}"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main Content Row -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="84"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" CornerRadius="0,0,0,8">
          <StackPanel VerticalAlignment="Top" Margin="0,12,0,0">

            <!-- Status Indicator -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14">
              <Ellipse x:Name="LedStatus" Width="8" Height="8" Fill="{StaticResource TextSubBrush}" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtLedLabel" Text="OFF" Foreground="{StaticResource TextSubBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="BtnHome" Style="{StaticResource SidebarButtonActiveStyle}"
                    Click="BtnHome_Click">
              <StackPanel HorizontalAlignment="Center">
                <fa:IconBlock Icon="House" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Home" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnConfig" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnConfig_Click">
              <StackPanel HorizontalAlignment="Center">
                <fa:IconBlock Icon="Sliders" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Config" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnHistory" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnHistory_Click">
              <StackPanel HorizontalAlignment="Center">
                <fa:IconBlock Icon="ClockRotateLeft" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Status" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnModManager" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnModManager_Click">
              <StackPanel HorizontalAlignment="Center">
                <fa:IconBlock Icon="PuzzlePiece" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Mods" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnGraphics" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnGraphics_Click">
              <StackPanel HorizontalAlignment="Center">
                <fa:IconBlock Icon="Palette" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Graphics" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnAiAssistant" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnAiAssistant_Click">
              <StackPanel HorizontalAlignment="Center">
                <fa:IconBlock Icon="Robot" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="AI Chat" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnTools" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnTools_Click">
              <StackPanel HorizontalAlignment="Center">
                <fa:IconBlock Icon="Wrench" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Tools" FontSize="11" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

          </StackPanel>
        </Border>

        <!-- Minimalist Separator -->
        <Rectangle Grid.Column="1" Fill="{StaticResource BorderCardBrush}"/>

        <!-- Content Area -->
        <Border Grid.Column="2" Background="{StaticResource BgContentBrush}" CornerRadius="0,0,8,0">
          <ContentControl x:Name="MainContent"/>
        </Border>

      </Grid>
    </Grid>
  </Border>
</Window>
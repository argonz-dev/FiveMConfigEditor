<Window x:Class="FiveMConfigEditorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FiveM Config Editor"
        Width="860" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

  <Border CornerRadius="12" Background="#FF1A0F0A"
          BorderBrush="#FF4A3020" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#FF8C00" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title Bar -->
      <Border Grid.Row="0" Background="#FF0F0A08" CornerRadius="12,12,0,0"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Logo + Title -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
            <Image Source="logo.png" Width="32" Height="32" Margin="0,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="FiveM Config Editor" Foreground="#FFFF8C00"
                       FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
          </StackPanel>

          <!-- Window Controls -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
            <Button x:Name="BtnCheckUpdate" Content="🔄" Width="32" Height="28"
                    Foreground="#FFAA8866" Background="Transparent" BorderThickness="0"
                    FontSize="13" Cursor="Hand" Click="BtnCheckUpdate_Click"
                    ToolTip="Check for Updates">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Foreground" Value="#FFAA8866"/>
                  <Setter Property="BorderThickness" Value="0"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF3A2510"/>
                            <Setter Property="Foreground" Value="#FFFF8C00"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>
            <Button x:Name="BtnMinimize" Content="—" Width="32" Height="28"
                    Foreground="#FFAA8866" Background="Transparent" BorderThickness="0"
                    FontSize="13" Cursor="Hand" Click="BtnMinimize_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Foreground" Value="#FFAA8866"/>
                  <Setter Property="BorderThickness" Value="0"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FF3A2510"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>
            <Button x:Name="BtnClose" Content="✕" Width="32" Height="28"
                    Foreground="#FFAA8866" Background="Transparent" BorderThickness="0"
                    FontSize="13" Cursor="Hand" Click="BtnClose_Click">
              <Button.Style>
                <Style TargetType="Button">
                  <Setter Property="Background" Value="Transparent"/>
                  <Setter Property="Foreground" Value="#FFAA8866"/>
                  <Setter Property="BorderThickness" Value="0"/>
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFFF4D4D"/>
                            <Setter Property="Foreground" Value="White"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </Button.Style>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main Content Row -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="1"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#FF0F0A08" CornerRadius="0,0,0,12">
          <StackPanel VerticalAlignment="Top" Margin="0,12,0,0">

            <!-- Status LED -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
              <Ellipse x:Name="LedStatus" Width="10" Height="10" Fill="#FFAA8866" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtLedLabel" Text="OFF" Foreground="#FFAA8866" FontSize="10" VerticalAlignment="Center"/>
            </StackPanel>

            <Button x:Name="BtnHome" Style="{StaticResource SidebarButtonActiveStyle}"
                    Click="BtnHome_Click">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🏠" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Home" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnConfig" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnConfig_Click">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="⚙" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Config" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnHistory" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnHistory_Click">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Status" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnModManager" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnModManager_Click">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Mods" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>

            <Button x:Name="BtnGraphics" Style="{StaticResource SidebarButtonStyle}"
                    Click="BtnGraphics_Click">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="🎨" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="Graphics" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
              </StackPanel>
            </Button>

          </StackPanel>
        </Border>

        <!-- Separator -->
        <Rectangle Grid.Column="1" Fill="#FF4A3020"/>

        <!-- Content Area -->
        <Border Grid.Column="2" Background="#FF1F1410" CornerRadius="0,0,12,0">
          <ContentControl x:Name="MainContent"/>
        </Border>

      </Grid>
    </Grid>
  </Border>
</Window>

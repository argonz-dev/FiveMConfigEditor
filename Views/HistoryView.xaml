<UserControl x:Class="FiveMConfigEditorWPF.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="Transparent">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <fa:IconBlock Icon="ListCheck" FontSize="16" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="Status CitizenFX.ini" Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Pemeriksaan status berkas aktif terhadap konfigurasi preset"
                 Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="24,3,0,0"/>
    </StackPanel>

    <!-- Status Card -->
    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,0,16">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File Path -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <fa:IconBlock Icon="FileLines" FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Berkas:" Foreground="{StaticResource TextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="TxtFilePath" Grid.Column="1" Text="Belum dipilih" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <fa:IconBlock Icon="CircleInfo" FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Status:" Foreground="{StaticResource TextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock x:Name="TxtStatus" Grid.Column="1" Text="Memuat..." Foreground="{StaticResource TextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
        </Grid>

        <!-- Save Button -->
        <Button x:Name="BtnSaveAsPreset" Grid.Row="2"
                Style="{StaticResource NeonButtonStyle}"
                Click="BtnSaveAsPreset_Click"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                Margin="0,10,0,0">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="FloppyDisk" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Simpan sebagai Preset Baru" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Current Config Display -->
    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderCardBrush}"
                BorderThickness="0,0,0,1" Padding="14,10" CornerRadius="8,8,0,0">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Sliders" FontSize="12" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="Konfigurasi Aktif Saat Ini" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource DarkScrollViewerStyle}">
          <StackPanel x:Name="ConfigPanel" Margin="16,12"/>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
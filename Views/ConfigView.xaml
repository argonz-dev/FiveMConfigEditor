<UserControl x:Class="FiveMConfigEditorWPF.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="Konfigurasi Global" Foreground="White"
               FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
    <TextBlock Grid.Row="0" Text="Pengaturan umum yang berlaku untuk semua preset"
               Foreground="#FFAA8866" FontSize="11" Margin="0,28,0,16"/>

    <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- FiveM Path -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="FiveM" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,14"/>

            <TextBlock Text="FiveM Folder Path" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtFiveMPath" Grid.Column="0"
                       Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0"/>
              <Button Grid.Column="1" Content="..." Width="38"
                      Style="{StaticResource NeonButtonSmallStyle}"
                      Click="BtnBrowseFiveM_Click"/>
            </Grid>

            <Border Background="#0FFF8C00" BorderBrush="#33FF8C00" BorderThickness="1"
                    CornerRadius="6" Padding="10,8">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ" Foreground="#FFFF8C00" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Foreground="#FFAA8866" FontSize="10" TextWrapping="Wrap">
                  <Run Text="Folder FiveM yang berisi subfolder mods dan plugins."/>
                  <LineBreak/>
                  <Run Text="Contoh: D:\FiveM\FiveM.app"/>
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Addons -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Addons" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,14"/>
            <TextBlock Text="ReShade5" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtReShade5" Style="{StaticResource DarkTextBoxStyle}"/>
          </StackPanel>
        </Border>

        <!-- Info box -->
        <Border Background="#0FFF8C00" BorderBrush="#33FF8C00" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="ℹ" Foreground="#FFFF8C00" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Foreground="#FFAA8866" FontSize="11" TextWrapping="Wrap">
              <Run Text="Pool Sizes dan Build Number diatur per-preset."/>
              <LineBreak/>
              <Run Text="Klik tombol ⚙ Config pada kartu preset di halaman Home."/>
            </TextBlock>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Button Grid.Row="2" Content="💾  Simpan"
            Style="{StaticResource NeonButtonStyle}"
            HorizontalAlignment="Right" Margin="0,14,0,0"
            Click="BtnSave_Click"/>
  </Grid>
</UserControl>

<UserControl x:Class="FiveMConfigEditorWPF.Views.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="Transparent">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Konfigurasi Global" Foreground="{StaticResource TextPrimaryBrush}"
                 FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="Pengaturan umum yang berlaku untuk semua preset FiveM"
                 Foreground="{StaticResource TextSubBrush}" FontSize="11"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- FiveM Path Card -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <fa:IconBlock Icon="FolderTree" FontSize="14" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="FiveM Environment" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock Text="FiveM Folder Path" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtFiveMPath" Grid.Column="0"
                       Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,8,0"/>
              <Button Grid.Column="1" Style="{StaticResource NeonButtonSmallStyle}"
                      Width="40" Click="BtnBrowseFiveM_Click">
                <fa:IconBlock Icon="FolderOpen" FontSize="11"/>
              </Button>
            </Grid>

            <Border Background="#10FF7A00" BorderBrush="#30FF7A00" BorderThickness="1"
                    CornerRadius="6" Padding="12,10">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="CircleInfo" FontSize="13" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                  <Run Text="Folder FiveM yang berisi subfolder mods dan plugins."/>
                  <LineBreak/>
                  <Run Text="Contoh: D:\\FiveM\\FiveM.app"/>
                </TextBlock>
              </StackPanel>
            </Border>

            <TextBlock Text="Update Channel" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,16,0,6"/>
            <ComboBox x:Name="CmbUpdateChannel" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,8">
              <ComboBoxItem Content="Production (Stable)" Tag="production"/>
              <ComboBoxItem Content="Beta (Latest Features)" Tag="beta"/>
            </ComboBox>

            <Border Background="#10FF7A00" BorderBrush="#30FF7A00" BorderThickness="1"
                    CornerRadius="6" Padding="12,10">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="CircleInfo" FontSize="13" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
                  <Run Text="Production: Versi stabil dan teruji."/>
                  <LineBreak/>
                  <Run Text="Beta: Versi mutakhir dengan pembaruan fitur eksperimental."/>
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Addons Card -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,16">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
              <fa:IconBlock Icon="PuzzlePiece" FontSize="14" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Text="Addons &amp; ReShade" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="ReShade 5 Path / Setting" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtReShade5" Style="{StaticResource DarkTextBoxStyle}"/>
          </StackPanel>
        </Border>

        <!-- Info Card -->
        <Border Background="#0D161B22" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                CornerRadius="6" Padding="14,12" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Lightbulb" FontSize="14" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
            <TextBlock Foreground="{StaticResource TextSubBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center">
              <Run Text="Pool Sizes dan Build Number diatur per-preset individual."/>
              <LineBreak/>
              <Run Text="Buka halaman Home dan klik tombol 'Config' pada kartu preset yang diinginkan."/>
            </TextBlock>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Bottom Action Bar -->
    <Button Grid.Row="2" Style="{StaticResource NeonButtonStyle}"
            HorizontalAlignment="Right" Margin="0,14,0,0"
            Click="BtnSave_Click">
      <StackPanel Orientation="Horizontal">
        <fa:IconBlock Icon="FloppyDisk" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="Simpan Konfigurasi" VerticalAlignment="Center"/>
      </StackPanel>
    </Button>
  </Grid>
</UserControl>
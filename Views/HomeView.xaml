<UserControl x:Class="FiveMConfigEditorWPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="Transparent">
  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <!-- Status bar -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Bar -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Preset Config" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold"/>
        <TextBlock Text="Kelola dan terapkan preset CitizenFX.ini" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,2,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="BtnPlayFiveM" Style="{StaticResource NeonButtonStyle}"
                Margin="0,0,8,0" Click="BtnPlayFiveM_Click"
                ToolTip="Launch FiveM dengan konfigurasi CitizenFX.ini saat ini">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Gamepad" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Play FiveM" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="BtnNewPreset" Style="{StaticResource GreenButtonStyle}"
                Click="BtnNewPreset_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Plus" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Preset Baru" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- File Picker -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource BorderCardBrush}"
              BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
        <Grid>
          <StackPanel x:Name="TxtPlaceholder" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
            <fa:IconBlock Icon="FileLines" FontSize="11" Foreground="{StaticResource TextSubBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Pilih file CitizenFX.ini Anda di sini..."
                       Foreground="{StaticResource TextSubBrush}" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBox x:Name="TxtFilePath" Style="{StaticResource DarkTextBoxStyle}"
                   Background="Transparent" BorderThickness="0"
                   TextChanged="TxtFilePath_TextChanged"/>
        </Grid>
      </Border>
      <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}"
              Margin="0,0,8,0" Click="BtnAutoDetect_Click"
              ToolTip="Auto-detect CitizenFX.ini dari folder FiveM">
        <StackPanel Orientation="Horizontal">
          <fa:IconBlock Icon="WandMagicSparkles" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Auto" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
              Click="BtnBrowse_Click">
        <StackPanel Orientation="Horizontal">
          <fa:IconBlock Icon="FolderOpen" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Browse" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Watcher Status -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
      <Ellipse x:Name="LedWatcher" Width="8" Height="8" Fill="{StaticResource TextSubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="TxtWatcherStatus" Text="Status Watcher: Belum Aktif"
                 Foreground="{StaticResource TextSubBrush}" FontSize="11" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Preset Cards -->
    <ScrollViewer Grid.Row="3" Margin="0,0,0,10" Padding="0,0,12,20"
                  Style="{StaticResource DarkScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="PresetPanel" Orientation="Vertical" Margin="0,0,0,10"/>
    </ScrollViewer>

    <!-- Status Bar -->
    <Border x:Name="StatusBarBorder" Grid.Row="4" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderCardBrush}"
            BorderThickness="1" CornerRadius="6" Padding="14,8" Visibility="Collapsed">
      <TextBlock x:Name="TxtStatus" Text="" Foreground="{StaticResource AccentGreenBrush}"
                 FontSize="11" FontWeight="SemiBold"/>
    </Border>
  </Grid>
</UserControl>
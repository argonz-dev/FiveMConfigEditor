<UserControl x:Class="FiveMConfigEditorWPF.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <!-- Status bar -->
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Top Bar -->
    <Grid Grid.Row="0" Margin="20,16,20,10">
      <TextBlock Text="Preset Config" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
      <Button x:Name="BtnNewPreset" Content="+ Buat Preset Baru"
              Style="{StaticResource GreenButtonStyle}"
              HorizontalAlignment="Right" Click="BtnNewPreset_Click"/>
    </Grid>

    <!-- File Picker -->
    <Grid Grid.Row="1" Margin="20,0,20,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#FF1E1E32" BorderBrush="#FF4A3020"
              BorderThickness="1" CornerRadius="6" Margin="0,0,8,0">
        <Grid>
          <TextBlock x:Name="TxtPlaceholder" Text="📁  Pilih file .ini Anda di sini..."
                     Foreground="#FFAA8866" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
          <TextBox x:Name="TxtFilePath" Style="{StaticResource DarkTextBoxStyle}"
                   Background="Transparent" BorderThickness="0"
                   TextChanged="TxtFilePath_TextChanged"/>
        </Grid>
      </Border>
      <Button Grid.Column="1" Content="🔍 Auto" Style="{StaticResource GreenButtonStyle}"
              Width="80" Margin="0,0,8,0" Click="BtnAutoDetect_Click"
              ToolTip="Auto-detect CitizenFX.ini dari folder FiveM"/>
      <Button Grid.Column="2" Content="Browse" Style="{StaticResource NeonButtonStyle}"
              Click="BtnBrowse_Click"/>
    </Grid>

    <!-- Watcher Status -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="20,0,20,14">
      <Ellipse x:Name="LedWatcher" Width="10" Height="10" Fill="#FFAA8866" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <TextBlock x:Name="TxtWatcherStatus" Text="Status Watcher: Belum Aktif"
                 Foreground="#FFAA8866" FontSize="11" VerticalAlignment="Center"/>
    </StackPanel>

    <!-- Preset Cards -->
    <ScrollViewer Grid.Row="3" Margin="20,0,20,0"
                  Style="{StaticResource DarkScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="PresetPanel" Orientation="Vertical"/>
    </ScrollViewer>

    <!-- Status Bar -->
    <Border Grid.Row="4" Background="#FF1F1410" Padding="20,8">
      <TextBlock x:Name="TxtStatus" Text="" Foreground="#FF2ECC71"
                 FontSize="11" FontWeight="SemiBold"/>
    </Border>
  </Grid>
</UserControl>

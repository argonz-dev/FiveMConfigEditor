<UserControl x:Class="FiveMConfigEditorWPF.Views.FiveMToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="Transparent">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <fa:IconBlock Icon="Wrench" FontSize="15" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="FiveM Tools" Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Kelola nickname fivem.cfg &amp; NUI, keybind, dan pembersih cache FiveM"
                 Foreground="{StaticResource TextSubBrush}" FontSize="11"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- Card 1: Nickname FiveM -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <fa:IconBlock Icon="User" FontSize="14" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Nickname FiveM (fivem.cfg &amp; NUI)" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="TxtCfgStatus" Grid.Column="1" Foreground="{StaticResource TextSubBrush}"
                         FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
            </Grid>

            <TextBlock Text="cl_nickname (fivem.cfg)" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="TxtNickname" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,10,0"/>
              <Button x:Name="BtnSaveNickname" Grid.Column="1" Style="{StaticResource NeonButtonStyle}" Click="BtnSaveNickname_Click">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="FloppyDisk" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Simpan Nickname" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Text="Kosongkan lalu simpan untuk menghapus override cl_nickname dari fivem.cfg."
                       Foreground="{StaticResource TextSubBrush}" FontSize="10.5" Margin="0,0,0,12"/>

            <!-- NUI nickOverride Box -->
            <Border Background="#10FF7A00" BorderBrush="#30FF7A00" BorderThickness="1"
                    CornerRadius="6" Padding="12,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <fa:IconBlock Grid.Column="0" Icon="CircleInfo" FontSize="13" Foreground="{StaticResource AccentOrangeBrush}"
                              Margin="0,0,10,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock x:Name="TxtNuiNick" Text="NUI nickOverride: Memeriksa..."
                             Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock x:Name="TxtNuiSource" Foreground="{StaticResource TextSubBrush}" FontSize="10.5"
                             TextTrimming="CharacterEllipsis" Visibility="Collapsed" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnUseNuiNick" Grid.Column="2" Style="{StaticResource SecondaryButtonSmallStyle}"
                        IsEnabled="False" Click="BtnUseNuiNick_Click" VerticalAlignment="Center"
                        Content="Pakai dari NUI"/>
              </Grid>
            </Border>

            <!-- Nickname Status Banner -->
            <Border x:Name="NicknameBanner" Visibility="Collapsed" CornerRadius="6" BorderThickness="1"
                    Padding="12,9" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock x:Name="IconNicknameBanner" Icon="CircleCheck" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtNicknameStatus" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Card 2: Keybind Manager -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <fa:IconBlock Icon="Keyboard" FontSize="14" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="Keybind Manager (fivem.cfg)" Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock x:Name="TxtKeybindCount" Grid.Column="1" Foreground="{StaticResource TextSubBrush}"
                         FontSize="11" VerticalAlignment="Center"/>
            </Grid>

            <!-- Table Header -->
            <Grid Margin="8,0,8,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="135"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="40"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Aktif" Foreground="{StaticResource TextSubBrush}" FontSize="11" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Mapper" Foreground="{StaticResource TextSubBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
              <TextBlock Grid.Column="2" Text="Key" Foreground="{StaticResource TextSubBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
              <TextBlock Grid.Column="3" Text="Command" Foreground="{StaticResource TextSubBrush}" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0"/>
              <TextBlock Grid.Column="4" Text="" Foreground="{StaticResource TextSubBrush}" FontSize="11"/>
            </Grid>

            <!-- Empty Keybinds State -->
            <Border x:Name="EmptyKeybindsBox" Visibility="Collapsed" Background="#FF0D1117"
                    BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1" CornerRadius="6"
                    Padding="14,12" Margin="0,0,0,10">
              <TextBlock Text="Belum ada keybind yang terbaca di fivem.cfg atau disabled_binds.json."
                         Foreground="{StaticResource TextSubBrush}" FontSize="11.5" HorizontalAlignment="Center"/>
            </Border>

            <!-- Keybind Rows -->
            <ItemsControl x:Name="KeybindsItems" Margin="0,0,0,10">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FF0D1117" BorderBrush="{StaticResource BorderCardBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="105"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0" Style="{StaticResource DarkCheckBoxStyle}"
                                IsChecked="{Binding IsActive, Mode=TwoWay}"
                                Click="ChkKeybindActive_Click"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="Aktifkan / nonaktifkan bind di fivem.cfg"/>
                      <TextBox Grid.Column="1" Style="{StaticResource DarkTextBoxStyle}"
                               Text="{Binding Mapper, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8,5" FontSize="11.5" Margin="4,0"/>
                      <TextBox Grid.Column="2" Style="{StaticResource DarkTextBoxStyle}"
                               Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8,5" FontSize="11.5" Margin="4,0"/>
                      <TextBox Grid.Column="3" Style="{StaticResource DarkTextBoxStyle}"
                               Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                               Padding="8,5" FontSize="11.5" Margin="4,0"/>
                      <Button Grid.Column="4" Style="{StaticResource RedButtonSmallStyle}"
                              Tag="{Binding}" Click="BtnDeleteKeybind_Click"
                              Width="30" Height="28" Padding="0" HorizontalAlignment="Right"
                              ToolTip="Hapus keybind ini">
                        <fa:IconBlock Icon="TrashCan" FontSize="11"/>
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Quick Add Row -->
            <Border Background="#0D161B22" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10,10" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="145"/>
                  <ColumnDefinition Width="115"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <TextBlock Text="Mapper" Foreground="{StaticResource TextSubBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                  <ComboBox x:Name="CmbNewMapper" Style="{StaticResource DarkComboBoxStyle}" SelectedIndex="0">
                    <ComboBoxItem Content="KEYBOARD"/>
                    <ComboBoxItem Content="MOUSE_BUTTON"/>
                    <ComboBoxItem Content="PAD_DIGITALBUTTON"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                  <TextBlock Text="Key (mis. F5)" Foreground="{StaticResource TextSubBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="TxtNewKey" Style="{StaticResource DarkTextBoxStyle}" Padding="8,6" ToolTip="Contoh: F5"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                  <TextBlock Text="Command (mis. e dance)" Foreground="{StaticResource TextSubBrush}" FontSize="10.5" Margin="0,0,0,4"/>
                  <TextBox x:Name="TxtNewCommand" Style="{StaticResource DarkTextBoxStyle}" Padding="8,6" ToolTip="Contoh: e dance"/>
                </StackPanel>
                <Button x:Name="BtnAddKeybind" Grid.Column="3" Style="{StaticResource GreenButtonSmallStyle}"
                        VerticalAlignment="Bottom" Height="31" Padding="12,5" Click="BtnAddKeybind_Click">
                  <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Plus" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Tambah" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <!-- Keybind Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button x:Name="BtnReloadKeybinds" Style="{StaticResource SecondaryButtonStyle}"
                      Margin="0,0,8,0" Click="BtnReloadKeybinds_Click">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="Rotate" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Muat Ulang" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnSaveKeybinds" Style="{StaticResource NeonButtonStyle}" Click="BtnSaveKeybinds_Click">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="FloppyDisk" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                  <TextBlock Text="Simpan Keybinds" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <!-- Keybind Status Banner -->
            <Border x:Name="KeybindBanner" Visibility="Collapsed" CornerRadius="6" BorderThickness="1"
                    Padding="12,9" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock x:Name="IconKeybindBanner" Icon="CircleCheck" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtKeybindStatus" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <!-- Card 3: FiveM Cache Manager -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="18,16">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <fa:IconBlock Icon="HardDrive" FontSize="14" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <TextBlock Text="FiveM Cache Manager" Foreground="{StaticResource TextPrimaryBrush}"
                             FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="TxtCacheSummary" Text="Memindai folder cache..." Foreground="{StaticResource TextSubBrush}"
                           FontSize="11" Margin="22,3,0,0"/>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnScanCache" Style="{StaticResource SecondaryButtonSmallStyle}"
                        Margin="0,0,8,0" Click="BtnScanCache_Click">
                  <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="Rotate" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Scan Ulang" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="BtnInstallCache" Style="{StaticResource GreenButtonSmallStyle}"
                        Click="BtnInstallCache_Click">
                  <StackPanel Orientation="Horizontal">
                    <fa:IconBlock Icon="BoxOpen" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Install Paket Cache (.zip/.exe)" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Cache Folder Rows -->
            <ItemsControl x:Name="CacheItems">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#FF0D1117" BorderBrush="{StaticResource BorderCardBrush}"
                          BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                     FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0" Background="#1AFF7A00" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FormattedSize}" Foreground="{StaticResource AccentOrangeBrush}"
                                       FontSize="10.5" FontWeight="SemiBold"/>
                          </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSubBrush}"
                                   FontSize="11" Margin="0,3,0,0"/>
                      </StackPanel>

                      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                        <TextBlock Foreground="{StaticResource TextSubBrush}" FontSize="11" HorizontalAlignment="Right">
                          <Run Text="{Binding FileCount, Mode=OneWay}"/>
                          <Run Text=" file"/>
                        </TextBlock>
                        <TextBlock FontSize="10.5" HorizontalAlignment="Right" Margin="0,2,0,0">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="Tersedia"/>
                              <Setter Property="Foreground" Value="#FF3FB950"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Exists}" Value="False">
                                  <Setter Property="Text" Value="Tidak ditemukan"/>
                                  <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonSmallStyle}"
                                Tag="{Binding}" IsEnabled="{Binding Exists}"
                                Margin="0,0,6,0" Click="BtnOpenCacheFolder_Click">
                          <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="FolderOpen" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Buka" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button Style="{StaticResource RedButtonSmallStyle}"
                                Tag="{Binding}" IsEnabled="{Binding Exists}"
                                Click="BtnClearCacheFolder_Click">
                          <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="TrashCan" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Bersihkan" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Cache Status Banner -->
            <Border x:Name="CacheBanner" Visibility="Collapsed" CornerRadius="6" BorderThickness="1"
                    Padding="12,9" Margin="0,6,0,0">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock x:Name="IconCacheBanner" Icon="CircleInfo" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtCacheStatus" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

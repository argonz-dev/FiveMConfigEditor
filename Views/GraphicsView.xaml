<UserControl x:Class="FiveMConfigEditorWPF.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="Transparent">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header & Info -->
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
        <fa:IconBlock Icon="Sliders" FontSize="16" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock Text="Pengaturan Grafis GTA V" Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="Konfigurasi visual gta5_settings.xml untuk kestabilan dan performa"
                 Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="24,0,0,12"/>
      
      <!-- File path info card -->
      <Border Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
              CornerRadius="6" Padding="12,10">
        <StackPanel>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <fa:IconBlock Icon="FileLines" FontSize="10" Foreground="{StaticResource TextSubBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="File:" Foreground="{StaticResource TextSubBrush}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtFilePath" Grid.Column="1" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
          </Grid>

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <fa:IconBlock Icon="CircleInfo" FontSize="10" Foreground="{StaticResource TextSubBrush}" Margin="0,0,4,0" VerticalAlignment="Center"/>
              <TextBlock Text="Status:" Foreground="{StaticResource TextSubBrush}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="TxtFileStatus" Grid.Column="1" Foreground="{StaticResource AccentOrangeBrush}" FontSize="11" VerticalAlignment="Center"/>
          </Grid>

          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource NeonButtonSmallStyle}" 
                    Margin="0,0,6,0" Click="BtnBrowse_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="FolderOpen" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="Browse" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource NeonButtonSmallStyle}" 
                    Margin="0,0,6,0" Click="BtnReload_Click">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="Rotate" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="Reload" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource GreenButtonSmallStyle}" 
                    Margin="0,0,6,0" Click="BtnBackup_Click" 
                    ToolTip="Backup current settings">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="FloppyDisk" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="Backup" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Style="{StaticResource RedButtonSmallStyle}" 
                    Click="BtnResetToSafe_Click"
                    ToolTip="Reset to safe default settings (fixes crashes)">
              <StackPanel Orientation="Horizontal">
                <fa:IconBlock Icon="ShieldHalved" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                <TextBlock Text="Reset Safe" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- Quick Presets -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16,14">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
              <fa:IconBlock Icon="GaugeHigh" FontSize="12" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Quick Presets" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            <UniformGrid Columns="4" HorizontalAlignment="Left">
              <Button Content="Ultra" Width="84" Margin="0,0,6,0"
                      Style="{StaticResource NeonButtonSmallStyle}" Click="BtnPresetUltra_Click"/>
              <Button Content="High" Width="84" Margin="0,0,6,0"
                      Style="{StaticResource NeonButtonSmallStyle}" Click="BtnPresetHigh_Click"/>
              <Button Content="Medium" Width="84" Margin="0,0,6,0"
                      Style="{StaticResource NeonButtonSmallStyle}" Click="BtnPresetMedium_Click"/>
              <Button Content="Low" Width="84"
                      Style="{StaticResource NeonButtonSmallStyle}" Click="BtnPresetLow_Click"/>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- Texture & Quality -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Texture &amp; Quality" Foreground="{StaticResource AccentOrangeBrush}" FontSize="12"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>
            
            <TextBlock Text="Texture Quality" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbTextureQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Normal"/>
              <ComboBoxItem Content="1 - High"/>
              <ComboBoxItem Content="2 - Very High"/>
            </ComboBox>

            <TextBlock Text="Shader Quality" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbShaderQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Normal"/>
              <ComboBoxItem Content="1 - High"/>
              <ComboBoxItem Content="2 - Very High"/>
            </ComboBox>

            <TextBlock Text="Anisotropic Filtering" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbAnisotropic" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,4">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - x2"/>
              <ComboBoxItem Content="2 - x4"/>
              <ComboBoxItem Content="3 - x8"/>
              <ComboBoxItem Content="4 - x16"/>
            </ComboBox>
          </StackPanel>
        </Border>

        <!-- Shadows -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Shadows" Foreground="{StaticResource AccentOrangeBrush}" FontSize="12"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>
            
            <TextBlock Text="Shadow Quality" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbShadowQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - Normal"/>
              <ComboBoxItem Content="2 - High"/>
              <ComboBoxItem Content="3 - Very High"/>
            </ComboBox>

            <TextBlock Text="Soft Shadows" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbSoftShadows" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Sharp"/>
              <ComboBoxItem Content="1 - Soft"/>
              <ComboBoxItem Content="2 - Softer"/>
              <ComboBoxItem Content="3 - Softest"/>
              <ComboBoxItem Content="4 - AMD CHS (AMD Only)"/>
              <ComboBoxItem Content="5 - NVIDIA PCSS (NVIDIA Only)"/>
            </ComboBox>

            <CheckBox x:Name="ChkLongShadows" Content="Long Shadows" 
                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkParticleShadows" Content="Particle Shadows" 
                      Style="{StaticResource DarkCheckBoxStyle}"/>
          </StackPanel>
        </Border>

        <!-- Reflections & Effects -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Reflections &amp; Effects" Foreground="{StaticResource AccentOrangeBrush}" FontSize="12"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>
            
            <TextBlock Text="Reflection Quality" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbReflectionQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Normal"/>
              <ComboBoxItem Content="1 - High"/>
              <ComboBoxItem Content="2 - Very High"/>
              <ComboBoxItem Content="3 - Ultra"/>
            </ComboBox>

            <TextBlock Text="Water Quality" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbWaterQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Normal"/>
              <ComboBoxItem Content="1 - High"/>
              <ComboBoxItem Content="2 - Very High"/>
            </ComboBox>

            <TextBlock Text="Particle Quality" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbParticleQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Normal"/>
              <ComboBoxItem Content="1 - High"/>
              <ComboBoxItem Content="2 - Very High"/>
            </ComboBox>

            <TextBlock Text="Grass Quality" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbGrassQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,4">
              <ComboBoxItem Content="0 - Normal"/>
              <ComboBoxItem Content="1 - High"/>
              <ComboBoxItem Content="2 - Very High"/>
              <ComboBoxItem Content="3 - Ultra"/>
            </ComboBox>
          </StackPanel>
        </Border>

        <!-- Anti-Aliasing -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Anti-Aliasing" Foreground="{StaticResource AccentOrangeBrush}" FontSize="12"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>
            
            <TextBlock Text="MSAA" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbMSAA" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="Off"/>
              <ComboBoxItem Content="2x"/>
              <ComboBoxItem Content="4x"/>
              <ComboBoxItem Content="8x"/>
            </ComboBox>

            <CheckBox x:Name="ChkFXAA" Content="FXAA" 
                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkTXAA" Content="TXAA" 
                      Style="{StaticResource DarkCheckBoxStyle}"/>
          </StackPanel>
        </Border>

        <!-- Post Processing -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Post Processing" Foreground="{StaticResource AccentOrangeBrush}" FontSize="12"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>
            
            <TextBlock Text="Post FX" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbPostFX" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Normal"/>
              <ComboBoxItem Content="1 - High"/>
              <ComboBoxItem Content="2 - Very High"/>
              <ComboBoxItem Content="3 - Ultra"/>
            </ComboBox>

            <CheckBox x:Name="ChkDoF" Content="Depth of Field" 
                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkSSAO" Content="SSAO (Ambient Occlusion)" 
                      Style="{StaticResource DarkCheckBoxStyle}"/>
          </StackPanel>
        </Border>

        <!-- Advanced -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16,14">
          <StackPanel>
            <TextBlock Text="Advanced" Foreground="{StaticResource AccentOrangeBrush}" FontSize="12"
                       FontWeight="SemiBold" Margin="0,0,0,12"/>
            
            <TextBlock Text="Tessellation" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <ComboBox x:Name="CmbTessellation" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,10">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - Normal"/>
              <ComboBoxItem Content="2 - High"/>
              <ComboBoxItem Content="3 - Very High"/>
            </ComboBox>

            <TextBlock Text="LOD Scale" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <Slider x:Name="SliderLodScale" Minimum="0" Maximum="1" Value="1" 
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtLodScale" Text="1.0" Foreground="{StaticResource TextSubBrush}" 
                       FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,10"/>

            <TextBlock Text="City Density" Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="0,0,0,4"/>
            <Slider x:Name="SliderCityDensity" Minimum="0" Maximum="1" Value="1" 
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Margin="0,0,0,2"/>
            <TextBlock x:Name="TxtCityDensity" Text="1.0" Foreground="{StaticResource TextSubBrush}" 
                       FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,4"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- Bottom Actions -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Style="{StaticResource GreenButtonStyle}" 
              Margin="0,0,8,0" Click="BtnLoadPreset_Click">
        <StackPanel Orientation="Horizontal">
          <fa:IconBlock Icon="FolderOpen" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Load Preset" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource NeonButtonStyle}" 
              Margin="0,0,8,0" Click="BtnSave_Click">
        <StackPanel Orientation="Horizontal">
          <fa:IconBlock Icon="Check" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Simpan" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <Button Style="{StaticResource NeonButtonStyle}" 
              Click="BtnSavePreset_Click">
        <StackPanel Orientation="Horizontal">
          <fa:IconBlock Icon="Bookmark" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
          <TextBlock Text="Simpan sebagai Preset" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
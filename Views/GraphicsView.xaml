<UserControl x:Class="FiveMConfigEditorWPF.Views.GraphicsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <Grid Margin="24,20,24,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="Graphics Settings" Foreground="White"
                 FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
      <TextBlock Text="Atur kualitas grafis GTA V (gta5_settings.xml)"
                 Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,12"/>
      
      <!-- File path info -->
      <Border Background="#0FFF8C00" BorderBrush="#33FF8C00" BorderThickness="1"
              CornerRadius="6" Padding="10,8">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <TextBlock Text="File: " Foreground="#FFFF8C00" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtFilePath" Foreground="#FFAA8866" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="Browse" Style="{StaticResource NeonButtonSmallStyle}" 
                    Margin="0,0,8,0" Click="BtnBrowse_Click"/>
            <Button Content="Reload" Style="{StaticResource NeonButtonSmallStyle}" 
                    Click="BtnReload_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Style="{StaticResource DarkScrollViewerStyle}"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel>

        <!-- Quality Presets -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Quick Presets" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,12"/>
            <UniformGrid Columns="4" HorizontalAlignment="Left">
              <Button Content="Ultra" Width="90" Margin="0,0,8,0"
                      Style="{StaticResource NeonButtonSmallStyle}" Click="BtnPresetUltra_Click"/>
              <Button Content="High" Width="90" Margin="0,0,8,0"
                      Style="{StaticResource NeonButtonSmallStyle}" Click="BtnPresetHigh_Click"/>
              <Button Content="Medium" Width="90" Margin="0,0,8,0"
                      Style="{StaticResource NeonButtonSmallStyle}" Click="BtnPresetMedium_Click"/>
              <Button Content="Low" Width="90"
                      Style="{StaticResource NeonButtonSmallStyle}" Click="BtnPresetLow_Click"/>
            </UniformGrid>
          </StackPanel>
        </Border>

        <!-- Texture & Quality -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Texture &amp; Quality" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,14"/>
            
            <TextBlock Text="Texture Quality" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbTextureQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Very Low"/>
              <ComboBoxItem Content="1 - Low"/>
              <ComboBoxItem Content="2 - Normal"/>
              <ComboBoxItem Content="3 - High"/>
              <ComboBoxItem Content="4 - Very High"/>
            </ComboBox>

            <TextBlock Text="Shader Quality" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbShaderQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Very Low"/>
              <ComboBoxItem Content="1 - Low"/>
              <ComboBoxItem Content="2 - Normal"/>
              <ComboBoxItem Content="3 - High"/>
              <ComboBoxItem Content="4 - Very High"/>
            </ComboBox>

            <TextBlock Text="Anisotropic Filtering" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbAnisotropic" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - x2"/>
              <ComboBoxItem Content="2 - x4"/>
              <ComboBoxItem Content="3 - x8"/>
              <ComboBoxItem Content="4 - x16"/>
            </ComboBox>
          </StackPanel>
        </Border>

        <!-- Shadows -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Shadows" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,14"/>
            
            <TextBlock Text="Shadow Quality" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbShadowQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - Low"/>
              <ComboBoxItem Content="2 - Medium"/>
              <ComboBoxItem Content="3 - High"/>
              <ComboBoxItem Content="4 - Very High"/>
            </ComboBox>

            <TextBlock Text="Soft Shadows" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbSoftShadows" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Softest"/>
              <ComboBoxItem Content="1 - Softer"/>
              <ComboBoxItem Content="2 - Soft"/>
              <ComboBoxItem Content="3 - Sharp"/>
              <ComboBoxItem Content="4 - Sharper"/>
              <ComboBoxItem Content="5 - Sharpest"/>
            </ComboBox>

            <CheckBox x:Name="ChkLongShadows" Content="Long Shadows" 
                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkParticleShadows" Content="Particle Shadows" 
                      Style="{StaticResource DarkCheckBoxStyle}"/>
          </StackPanel>
        </Border>

        <!-- Reflections & Effects -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Reflections &amp; Effects" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,14"/>
            
            <TextBlock Text="Reflection Quality" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbReflectionQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - Low"/>
              <ComboBoxItem Content="2 - Medium"/>
              <ComboBoxItem Content="3 - High"/>
              <ComboBoxItem Content="4 - Very High"/>
            </ComboBox>

            <TextBlock Text="Water Quality" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbWaterQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Low"/>
              <ComboBoxItem Content="1 - High"/>
              <ComboBoxItem Content="2 - Very High"/>
            </ComboBox>

            <TextBlock Text="Particle Quality" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbParticleQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Low"/>
              <ComboBoxItem Content="1 - Normal"/>
              <ComboBoxItem Content="2 - High"/>
              <ComboBoxItem Content="3 - Very High"/>
            </ComboBox>

            <TextBlock Text="Grass Quality" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbGrassQuality" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Low"/>
              <ComboBoxItem Content="1 - Normal"/>
              <ComboBoxItem Content="2 - High"/>
              <ComboBoxItem Content="3 - Very High"/>
              <ComboBoxItem Content="4 - Ultra"/>
            </ComboBox>
          </StackPanel>
        </Border>

        <!-- Anti-Aliasing -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Anti-Aliasing" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,14"/>
            
            <TextBlock Text="MSAA" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbMSAA" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - x2"/>
              <ComboBoxItem Content="2 - x4"/>
              <ComboBoxItem Content="3 - x8"/>
            </ComboBox>

            <CheckBox x:Name="ChkFXAA" Content="FXAA" 
                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkTXAA" Content="TXAA" 
                      Style="{StaticResource DarkCheckBoxStyle}"/>
          </StackPanel>
        </Border>

        <!-- Post Processing -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Post Processing" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,14"/>
            
            <TextBlock Text="Post FX" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbPostFX" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - Low"/>
              <ComboBoxItem Content="2 - Normal"/>
              <ComboBoxItem Content="3 - High"/>
              <ComboBoxItem Content="4 - Very High"/>
            </ComboBox>

            <CheckBox x:Name="ChkDoF" Content="Depth of Field" 
                      Style="{StaticResource DarkCheckBoxStyle}" Margin="0,0,0,8"/>
            <CheckBox x:Name="ChkSSAO" Content="SSAO (Ambient Occlusion)" 
                      Style="{StaticResource DarkCheckBoxStyle}"/>
          </StackPanel>
        </Border>

        <!-- Advanced -->
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14" Padding="18,14">
          <StackPanel>
            <TextBlock Text="Advanced" Foreground="#FFFF8C00" FontSize="13"
                       FontWeight="Bold" Margin="0,0,0,14"/>
            
            <TextBlock Text="Tessellation" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <ComboBox x:Name="CmbTessellation" Style="{StaticResource DarkComboBoxStyle}" Margin="0,0,0,12">
              <ComboBoxItem Content="0 - Off"/>
              <ComboBoxItem Content="1 - Low"/>
              <ComboBoxItem Content="2 - Medium"/>
              <ComboBoxItem Content="3 - High"/>
              <ComboBoxItem Content="4 - Very High"/>
            </ComboBox>

            <TextBlock Text="LOD Scale" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <Slider x:Name="SliderLodScale" Minimum="0" Maximum="2" Value="1" 
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Style="{StaticResource DarkSliderStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtLodScale" Text="1.0" Foreground="#FFAA8866" 
                       FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,12"/>

            <TextBlock Text="City Density" Foreground="#FFAA8866" FontSize="11" Margin="0,0,0,5"/>
            <Slider x:Name="SliderCityDensity" Minimum="0" Maximum="1" Value="1" 
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Style="{StaticResource DarkSliderStyle}" Margin="0,0,0,4"/>
            <TextBlock x:Name="TxtCityDensity" Text="1.0" Foreground="#FFAA8866" 
                       FontSize="10" HorizontalAlignment="Right" Margin="0,0,0,12"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Save" Style="{StaticResource NeonButtonStyle}" 
              Margin="0,0,8,0" Click="BtnSave_Click"/>
      <Button Content="Save as Preset" Style="{StaticResource NeonButtonStyle}" 
              Click="BtnSavePreset_Click"/>
    </StackPanel>
  </Grid>
</UserControl>

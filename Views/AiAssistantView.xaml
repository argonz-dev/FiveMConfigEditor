<UserControl x:Class="FiveMConfigEditorWPF.Views.AiAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             Background="Transparent">

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderCardBrush}"
            BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="Robot" FontSize="15" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <TextBlock Text="AI Assistant" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
          <TextBlock Text="Konsultasi optimasi performa dan konfigurasi grafis GTA V" 
                     Foreground="{StaticResource TextSubBrush}" FontSize="11" Margin="23,2,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- Provider Status Badge -->
          <Border Background="{StaticResource BgDeepBrush}" BorderBrush="{StaticResource BorderCardBrush}"
                  BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#FF2EA043" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtProviderStatus" Text="VPS 103 (gemini-3.8-flash-high)"
                         Foreground="{StaticResource TextSubBrush}" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>

          <!-- Settings Button -->
          <Button x:Name="BtnSettings" Width="30" Height="30" Margin="0,0,6,0"
                  Background="Transparent" BorderThickness="0"
                  Cursor="Hand" Click="BtnSettings_Click"
                  ToolTip="Konfigurasi AI Provider &amp; Model">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#FF21262D"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <fa:IconBlock Icon="Gear" FontSize="13" Foreground="{StaticResource TextSubBrush}"/>
          </Button>

          <!-- Clear Chat Button -->
          <Button x:Name="BtnClearChat" Width="30" Height="30"
                  Background="Transparent" BorderThickness="0"
                  Cursor="Hand" Click="BtnClearChat_Click"
                  ToolTip="Bersihkan riwayat chat">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#22DA3633"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <fa:IconBlock Icon="TrashCan" FontSize="13" Foreground="{StaticResource TextSubBrush}"/>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Chat Messages -->
    <Border Grid.Row="1" Background="{StaticResource BgDeepBrush}" CornerRadius="6" BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1">
      <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="14"
                    Style="{StaticResource DarkScrollViewerStyle}">
        <StackPanel x:Name="ChatMessagesPanel"/>
      </ScrollViewer>
    </Border>

    <!-- Quick Actions -->
    <Border Grid.Row="2" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderCardBrush}"
            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,10">
      <StackPanel>
        <TextBlock Text="Aksi Cepat:" Foreground="{StaticResource TextSubBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <WrapPanel>
          <Button Margin="0,0,8,6" Padding="10,6"
                  Background="#FF21262D" Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                  FontSize="11" Cursor="Hand" Click="BtnQuickCleanCache_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Broom" FontSize="10" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="⚡ Bersihkan Cache FiveM" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>

          <Button Margin="0,0,8,6" Padding="10,6"
                  Background="#FF21262D" Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                  FontSize="11" Cursor="Hand" Click="BtnQuickOptimizeFps_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Bolt" FontSize="10" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="🚀 Auto-Optimasi FPS" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>

          <Button Margin="0,0,8,6" Padding="10,6"
                  Background="#FF21262D" Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                  FontSize="11" Cursor="Hand" Click="BtnQuickPowerPlan_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Fire" FontSize="10" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="⚡ High Performance Mode" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Margin="0,0,8,6" Padding="10,6"
                  Background="#FF21262D" Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                  FontSize="11" Cursor="Hand" Click="BtnQuickOptimizePools_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Microchip" FontSize="10" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="🛠️ Memory Pools" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Margin="0,0,8,6" Padding="10,6"
                  Background="#FF21262D" Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                  FontSize="11" Cursor="Hand" Click="BtnQuickRTX_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="GaugeHigh" FontSize="10" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Best Settings RTX" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>

          <Button Padding="10,6"
                  Background="#FF21262D" Foreground="{StaticResource TextPrimaryBrush}"
                  BorderBrush="{StaticResource BorderCardBrush}" BorderThickness="1"
                  FontSize="11" Cursor="Hand" Click="BtnQuickLowFPS_Click">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentOrangeBrush}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <fa:IconBlock Icon="Wrench" FontSize="10" Foreground="{StaticResource AccentOrangeBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
              <TextBlock Text="Fix Low FPS" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </WrapPanel>
      </StackPanel>
    </Border>

    <!-- Input Area -->
    <Border Grid.Row="3" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderCardBrush}"
            BorderThickness="1" CornerRadius="6" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="TxtUserInput" Grid.Column="0"
                 Style="{StaticResource DarkTextBoxStyle}"
                 TextWrapping="Wrap" MaxHeight="80"
                 VerticalScrollBarVisibility="Auto"
                 KeyDown="TxtUserInput_KeyDown"/>

        <Button x:Name="BtnSend" Grid.Column="1"
                Style="{StaticResource NeonButtonStyle}"
                Width="90" Height="36" Margin="8,0,0,0"
                Click="BtnSend_Click">
          <StackPanel Orientation="Horizontal">
            <fa:IconBlock Icon="PaperPlane" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock Text="Kirim" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

  </Grid>
</UserControl>